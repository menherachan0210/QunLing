+@pytest.mark.asyncio
+@pytest.mark.parametrize("statement,goal", [
+    ("这回发挥真稳。", "根据画面判断这句话是赞扬还是有反差；证据不足时保留歧义。"),
+    ("两杯都是清水。", "判断是否只是普通陈述，不预设玩笑。"),
