diff --git a/.venv/Lib/site-packages/langbot_plugin/api/entities/builtin/platform/message.py b/.venv/Lib/site-packages/langbot_plugin/api/entities/builtin/platform/message.py
--- a/.venv/Lib/site-packages/langbot_plugin/api/entities/builtin/platform/message.py
+++ b/.venv/Lib/site-packages/langbot_plugin/api/entities/builtin/platform/message.py
@@ -299,6 +299,30 @@
     origin: MessageChain
     """The message chain object of the original message to be quoted."""
 
+    def __str__(self):
+        # Display text is not a serialization format. Never expand attachment
+        # fields (including pixels, signed URLs and nested object reprs).
+        pieces = []
+        remaining = 4096
+        for item in self.origin[:32]:
+            if isinstance(item, Source):
+                continue
+            if isinstance(item, Plain):
+                text = item.text[:remaining]
+            elif isinstance(item, (At, AtAll, Face)):
+                text = str(item)[:min(remaining, 128)]
+            else:
+                text = f"[{item.type[:40]}]"[:remaining]
+            pieces.append(text)
+            remaining -= len(text)
+            if not remaining:
+                break
+        suffix = "..." if not remaining or len(self.origin) > 32 else ""
+        return "[Quote: " + "".join(pieces) + suffix + "]"
+
+    def __repr__(self):
+        return str(self)
+
 
 class At(MessageComponent):
     """At someone."""
