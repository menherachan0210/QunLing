+PREFIX = '[Group history speaker: '
+
+
+def platform_context(*, group=True, actor='member-a'):
+    """Build the real Pipeline shape: subject=message, delivery.target=group."""
+    query = SimpleNamespace(
+        launcher_type=LauncherTypes.GROUP if group else LauncherTypes.PERSON,
+        launcher_id='synthetic-group' if group else actor,
+        sender_id=actor,
+        bot_uuid='bot-a',
+        query_id=7,
+        variables={},
+        message_chain=None,
+        adapter=None,
+    )
+    event = SimpleNamespace(
+        event_type='message.received',
+        data={},
+        actor=ActorContext(actor_type='user', actor_id=actor, actor_name='Same nickname'),
+        subject=QueryEntryAdapter._build_subject_context(query),
+        delivery=QueryEntryAdapter._build_delivery_context(query),
+        raw_ref=None,
+    )
+    return freeze_platform_context(event)
+
+
+def group_session(*, actor='member-a'):
+    return {'authorization': {'platform_context': platform_context(actor=actor)}}
+
+
+def user_item(actor='member-a', content='Synthetic prior question', **kwargs):
+    return {
+        'transcript_id': 'transcript-a',
+        'event_id': 'event-a',
+        'item_type': 'message',
+        'role': 'user',
+        'seq': 7,
+        'cursor': '7',
+        'content': 'Synthetic prior question',
+        'content_json': {'role': 'user', 'content': content},
+        'metadata': {'actor_type': 'user', 'actor_id': actor, 'actor_name': 'Same nickname'},
+        **kwargs,
+    }
+
+
+def speaker_label(item):
+    content = item['content_json']['content']
+    first = content[0]['text'] if isinstance(content, list) else content
+    line = first.splitlines()[0]
+    assert line.startswith(PREFIX) and line.endswith(']')
+    return json.loads(line[len(PREFIX) : -1])
+
+
+def test_real_pipeline_group_scope_and_labels_are_stable_when_questioner_changes():
+    session = group_session()
+    frozen = session['authorization']['platform_context']
+    assert frozen['subject']['subject_type'] == 'message'
+    assert frozen['subject']['data']['launcher_type'] == 'group'
+    assert frozen['delivery']['reply_target']['target_type'] == 'group'
+    items = [user_item('member-a'), user_item('member-b')]
+    original = copy.deepcopy(items)
+
+    first = _project_group_history_items(items, session)
+    second = _project_group_history_items(items, group_session(actor='member-b'))
+
+    assert first == second
+    assert [speaker_label(item) for item in first] == [
+        {'actor_type': 'user', 'actor_id': 'member-a'},
+        {'actor_type': 'user', 'actor_id': 'member-b'},
+    ]
+    assert first[0]['content'] != first[1]['content']
+    assert items == original
+    # A caller mutating a nested response cannot rewrite cached/store data.
+    first[0]['metadata']['actor_id'] = 'changed'
+    assert items == original
+
+
+@pytest.mark.parametrize(
+    'content',
+    [
+        'Synthetic text',
+        [{'type': 'text', 'text': 'Synthetic text'}],
+        [
+            {'type': 'text', 'text': 'Describe the attachment'},
+            {'type': 'image_url', 'image_url': {'url': 'https://example.test/synthetic.png'}},
+        ],
+        [{'type': 'image_url', 'image_url': {'url': 'https://example.test/synthetic.png'}}],
+        [],
+        None,
+    ],
+)
+def test_projection_preserves_text_and_multimodal_elements(content):
+    item = user_item(content=content, attachment_refs=[{'attachment_id': 'synthetic-attachment'}])
+    original = copy.deepcopy(item)
+    result = _project_group_history_items([item], group_session())[0]
+
+    message = Message.model_validate(result['content_json'])
+    assert message.role == 'user'
+    assert speaker_label(result) == {'actor_type': 'user', 'actor_id': 'member-a'}
+    if isinstance(content, list):
+        assert result['content_json']['content'][1:] == content
+    elif isinstance(content, str):
+        assert result['content_json']['content'].endswith(content)
+    else:
+        assert result['content_json']['content'].endswith(original['content'])
+    assert result['attachment_refs'] == original['attachment_refs']
+    assert result['cursor'] == '7' and result['seq'] == 7
+    assert item == original
+
