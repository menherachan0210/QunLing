+async def register_run(env, *, group=True, allowed=True):
+    await env.registry.register(
+        run_id='run-a',
+        runner_id='plugin:test/runner/default',
+        query_id=None,
+        plugin_identity='test/runner',
+        resources=make_resources(),
+        conversation_id='conversation-a',
+        bot_id='bot-a',
+        workspace_id='workspace-test',
+        thread_id='thread-a',
+        available_apis={'history_page': allowed, 'history_search': allowed},
+        platform_context=platform_context(group=group),
+    )
+
+
+async def seed_history(store):
+    for index, overrides in enumerate(
+        [
+            {},
+            {'actor_id': 'member-b'},
+            {'bot_id': 'other-bot'},
+            {'workspace_id': 'other-workspace'},
+            {'thread_id': 'other-thread'},
+            {'conversation_id': 'other-conversation'},
+        ]
+    ):
+        scope = {
+            'conversation_id': 'conversation-a',
+            'bot_id': 'bot-a',
+            'workspace_id': 'workspace-test',
+            'thread_id': 'thread-a',
+            **{key: value for key, value in overrides.items() if key != 'actor_id'},
+        }
+        await store.append_transcript(
+            transcript_id=f'transcript-{index}',
+            event_id=f'event-{index}',
+            role='user',
+            content='Synthetic searchable message',
+            content_json={'role': 'user', 'content': 'Synthetic searchable message'},
+            metadata={'actor_type': 'user', 'actor_id': overrides.get('actor_id', 'member-a')},
+            **scope,
+        )
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('action', [PluginToRuntimeAction.HISTORY_PAGE, PluginToRuntimeAction.HISTORY_SEARCH])
+@pytest.mark.parametrize('group', [True, False])
+async def test_history_api_projects_after_scope_filters_without_storage_changes(history_env, action, group):
+    await register_run(history_env, group=group)
+    store = TranscriptStore(history_env.engine)
+    await seed_history(store)
+    scope = {'bot_id': 'bot-a', 'workspace_id': 'workspace-test', 'thread_id': 'thread-a', 'strict_thread': True}
+    before, _, _, _ = await store.page_transcript('conversation-a', **scope)
+    request = {
+        'run_id': 'run-a',
+        'caller_plugin_identity': 'test/runner',
+        'query': 'Synthetic',
+        # Untrusted request hints must not change the frozen private/group scope.
+        'launcher_type': 'group',
+        'platform_context': platform_context(group=True),
+    }
+    if action == PluginToRuntimeAction.HISTORY_PAGE:
+        request['limit'] = 1
+    result = await history_env.handler.actions[action.value](request)
+    assert result.code == 0
+    if action == PluginToRuntimeAction.HISTORY_PAGE:
+        HistoryPage.model_validate(result.data)
+        raw, next_cursor, prev_cursor, has_more = await store.page_transcript('conversation-a', limit=1, **scope)
+        assert result.data['next_cursor'] == (str(next_cursor) if next_cursor else None)
+        assert result.data['prev_cursor'] == (str(prev_cursor) if prev_cursor else None)
+        assert result.data['has_more'] == has_more
+    else:
+        HistorySearchResult.model_validate(result.data)
+        raw = await store.search_transcript('conversation-a', 'Synthetic', **scope)
+        assert result.data['total_count'] == 2
+    assert {item['transcript_id'] for item in result.data['items']} <= {'transcript-0', 'transcript-1'}
+    assert len(result.data['items']) == len(raw)
+    if group:
+        assert all(speaker_label(item)['actor_type'] == 'user' for item in result.data['items'])
+    else:
+        assert result.data['items'] == raw
+    after, _, _, _ = await store.page_transcript('conversation-a', **scope)
+    assert after == before
+
