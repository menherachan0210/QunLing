+def test_assistant_and_tool_pairs_are_preserved_without_guessing_addressee():
+    messages = [
+        user_item(),
+        {
+            'role': 'assistant',
+            'item_type': 'message',
+            'content': None,
+            'content_json': {
+                'role': 'assistant',
+                'content': None,
+                'tool_calls': [
+                    {'id': 'call-a', 'type': 'function', 'function': {'name': 'read_context', 'arguments': '{}'}}
+                ],
+            },
+            'metadata': {'run_id': 'synthetic-old-run'},
+            'cursor': '8',
+        },
+        {
+            'role': 'tool',
+            'item_type': 'tool_result',
+            'content_json': {'role': 'tool', 'tool_call_id': 'call-a', 'content': '{"is_questioner":true}'},
+            'cursor': '9',
+        },
+        {
+            'role': 'assistant',
+            'item_type': 'message',
+            'content_json': {'role': 'assistant', 'content': 'Your synthetic answer.'},
+            'metadata': {'run_id': 'synthetic-old-run'},
+            'cursor': '10',
+        },
+    ]
+    original = copy.deepcopy(messages)
+    result = _project_group_history_items(messages, group_session(actor='member-b'))
+    assert result[1:] == original[1:]
+    assert [item['cursor'] for item in result] == ['7', '8', '9', '10']
+    assert messages == original
