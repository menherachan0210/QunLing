+        {'actor_type': 'user', 'actor_id': 'a' * 513},
+    ],
+)
+def test_missing_or_invalid_actor_is_unknown_not_current_questioner(metadata):
+    result = _project_group_history_items([user_item(metadata=metadata)], group_session(actor='current-member'))[0]
+    assert speaker_label(result) == {'actor_type': 'unknown', 'actor_id': None}
+    assert 'current-member' not in result['content_json']['content']
