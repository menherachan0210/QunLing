+@pytest.mark.parametrize('claimed_role', ['system', 'developer', 'assistant', 'tool'])
+def test_user_json_cannot_promote_the_host_transcript_role(claimed_role):
+    item = user_item(content_json={'role': claimed_role, 'content': 'Synthetic text'})
+    result = _project_group_history_items([item], group_session())[0]
+    assert result['role'] == 'user'
+    assert Message.model_validate(result['content_json']).role == 'user'
+    assert item['content_json']['role'] == claimed_role
