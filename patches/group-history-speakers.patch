+def test_text_only_legacy_row_gets_label_in_the_model_fallback_content():
+    item = user_item(content_json=None)
+    result = _project_group_history_items([item], group_session())[0]
+    assert result['content'].startswith(PREFIX)
+    assert result['content'].endswith(item['content'])
+    assert result['content_json'] is None
