+def test_actor_type_is_part_of_identity_and_integer_ids_have_stable_text_form():
+    items = [
+        user_item(metadata={'actor_type': 'user', 'actor_id': 101}),
+        user_item(metadata={'actor_type': 'bot', 'actor_id': '101'}),
+    ]
+    result = _project_group_history_items(items, group_session())
+    assert [speaker_label(item) for item in result] == [
+        {'actor_type': 'user', 'actor_id': '101'},
+        {'actor_type': 'bot', 'actor_id': '101'},
+    ]
