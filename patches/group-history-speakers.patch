+@pytest.fixture
+async def history_env(monkeypatch):
+    engine = create_async_engine('sqlite+aiosqlite:///:memory:')
+    async with engine.begin() as conn:
+        await conn.run_sync(Base.metadata.create_all)
+    registry = AgentRunSessionRegistry()
+    monkeypatch.setattr('langbot.pkg.agent.runner.session_registry._global_registry', registry)
+    app = SimpleNamespace(logger=MagicMock(), persistence_mgr=MagicMock())
+    app.persistence_mgr.get_db_engine.return_value = engine
+
+    async def disconnect():
+        return True
+
+    handler = bind_runtime_action_context(RuntimeConnectionHandler(SimpleNamespace(), disconnect, app), app)
+    yield SimpleNamespace(engine=engine, registry=registry, handler=handler, app=app)
+    await engine.dispose()
+
