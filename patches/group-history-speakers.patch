+def _is_group_history_session(session: dict[str, Any]) -> bool:
+    """Read chat scope from the Host-frozen run context, never request data."""
+    context = _get_run_authorization(session).get('platform_context') or {}
+    if not isinstance(context, dict):
+        return False
+    delivery = context.get('delivery') or {}
+    target = delivery.get('reply_target') if isinstance(delivery, dict) else None
+    if isinstance(target, dict) and target.get('target_type') is not None:
+        return target['target_type'] == 'group'
+    subject = context.get('subject') or {}
+    if not isinstance(subject, dict):
+        return False
+    if subject.get('subject_type') == 'group':
+        return True
+    data = subject.get('data') or {}
+    return subject.get('subject_type') == 'message' and isinstance(data, dict) and data.get('launcher_type') == 'group'
+
+
+def _history_actor_field(value: Any, max_chars: int) -> str | None:
+    """Keep exact bounded identities; never truncate two actors into one."""
+    if type(value) is int:
+        value = str(value)
+    if not isinstance(value, str) or not value.strip() or len(value) > max_chars:
+        return None
+    return value if all(char.isprintable() for char in value) else None
+
+
+def _project_group_history_items(items: list[dict[str, Any]], session: dict[str, Any]) -> list[dict[str, Any]]:
+    """Preserve group speakers in model-visible text without rewriting storage.
+
+    LocalAgent projects content_json directly and discards Transcript metadata.
+    Stable actor identities survive its compaction text path; labels relative to
+    the current questioner would become incorrect on another member's next turn.
+    """
+    if not _is_group_history_session(session):
+        return items
+    projected = copy.deepcopy(items)
+    for item in projected:
+        if item.get('role') != 'user' or item.get('item_type', 'message') != 'message':
+            continue
+        metadata = item.get('metadata')
+        metadata = metadata if isinstance(metadata, dict) else {}
+        actor_type = _history_actor_field(metadata.get('actor_type'), 64)
+        actor_id = _history_actor_field(metadata.get('actor_id'), 512)
+        if actor_type is None or actor_id is None:
+            actor_type, actor_id = 'unknown', None
+        identity = json.dumps({'actor_type': actor_type, 'actor_id': actor_id}, ensure_ascii=True)
+        prefix = f'[Group history speaker: {identity}]\n'
+        text = item.get('content')
+        if isinstance(text, str):
+            item['content'] = prefix + text
+        message = item.get('content_json')
+        if isinstance(message, dict):
+            # The Host's row role is canonical, even if JSON claims a system role.
+            message['role'] = 'user'
+            content = message.get('content')
+            if isinstance(content, list):
+                message['content'] = [{'type': 'text', 'text': prefix}, *content]
+            elif isinstance(content, str):
+                message['content'] = prefix + content
+            elif content is None:
+                message['content'] = prefix + (text if isinstance(text, str) else '')
+    return projected
 
 
