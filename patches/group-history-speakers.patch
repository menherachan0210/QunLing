+        else:
+            request['filters'] = {'conversation_id': 'other-conversation'}
+    history_env.app.persistence_mgr.get_db_engine.reset_mock()
+    result = await history_env.handler.actions[action.value](request)
+    assert result.code != 0
+    history_env.app.persistence_mgr.get_db_engine.assert_not_called()
