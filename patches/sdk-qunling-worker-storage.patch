+
+    @staticmethod
+    def _qunling_worker_environment() -> dict[str, str]:
+        # QunLing's trusted host, daemon and direct plugin workers share one
+        # scoped attachment store. Only this configured absolute path and PATH
+        # (for the bundled native decoder) cross the process boundary, never
+        # arbitrary provider keys or the rest of the parent's environment.
+        # The nsjail/shared branch above deliberately does not call this helper.
+        value = os.environ.get("QUNLING_DATA_DIR")
+        if not value:
+            return {}
+        if not pathlib.Path(value).is_absolute():
+            raise RuntimeError("QUNLING_DATA_DIR must be an absolute host path")
+        environment = {"QUNLING_DATA_DIR": value}
+        if (path := os.environ.get("PATH")) is not None:
+            environment["PATH"] = path
+        return environment
 
