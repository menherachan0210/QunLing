@@ -0,0 +1,31 @@
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from langbot.pkg.vector.vdbs.chroma import ChromaVectorDatabase
+
+
+@pytest.mark.asyncio
+async def test_filtered_delete_reports_count_and_preserves_other_memory_scopes(tmp_path):
+    database = ChromaVectorDatabase(SimpleNamespace(logger=MagicMock()), base_path=str(tmp_path / 'chroma'))
+    collection = 'memory-delete-regression'
+    await database.add_embeddings(
+        collection,
+        ids=['alice-1', 'alice-2', 'bob-1'],
+        embeddings_list=[[1.0, 0.0], [0.9, 0.1], [0.0, 1.0]],
+        metadatas=[{'user_key': 'alice'}, {'user_key': 'alice'}, {'user_key': 'bob'}],
+    )
+
+    deleted = await database.delete_by_filter(collection, {'user_key': 'alice'})
+
+    remaining, total = await database.list_by_filter(collection)
+    assert [item['id'] for item in remaining] == ['bob-1']
+    assert total == 1
+    assert deleted == 2
+    assert await database.delete_by_filter(collection, {'user_key': 'alice'}) == 0
+
+    assert await database.delete_by_filter(collection, {'user_key': 'bob'}) == 1
+    remaining, total = await database.list_by_filter(collection)
+    assert remaining == []
+    assert total == 0
