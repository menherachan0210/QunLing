+    def _serialize_tool_arguments(self, arguments: object) -> str | None:
+        """Redact passwords in the monitoring copy, never in execution inputs."""
+        def redact(value, depth=0):
+            if depth > 20:
+                return '[redacted: depth limit]'
+            if isinstance(value, dict):
+                return {
+                    str(key): '[redacted]' if str(key).strip().casefold() == 'password'
+                    else redact(item, depth + 1)
+                    for key, item in value.items()
+                }
+            if isinstance(value, (list, tuple)):
+                return [redact(item, depth + 1) for item in value]
+            if isinstance(value, str) and value.lstrip().startswith(('{', '[', '"')):
+                # Some providers return arguments as JSON text, including a
+                # JSON string nested under another tool's arguments field.
+                try:
+                    decoded = json.loads(value)
+                except (ValueError, RecursionError):
+                    return '[redacted: invalid structured arguments]'
+                return json.dumps(redact(decoded, depth + 1), ensure_ascii=False)
+            if value is None or isinstance(value, (str, bool, int, float)):
+                return value
+            # A custom object's repr can contain credentials; tool arguments
+            # are JSON data, so there is no reason to persist an unknown repr.
+            return '[redacted: unsupported argument]'
+
+        return self._serialize_tool_payload(redact(arguments))
+
