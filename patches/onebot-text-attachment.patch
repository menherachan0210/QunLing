+"""Bounded, read-only OneBot file URL bridge tests without network requests."""
+
+from unittest.mock import AsyncMock
+
+import pytest
+
+from langbot.pkg.platform.adapters.aiocqhttp.platform_api import get_group_file_url, get_private_file_url
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('group_id', ['20001', 20001])
+async def test_group_lookup_preserves_file_id_and_only_returns_url(group_id):
+    bot = AsyncMock()
+    bot.call_action.return_value = {
+        'url': 'https://example.test/file?signature=test',
+        'private_metadata': 'not returned',
+    }
+    result = await get_group_file_url(bot, {'group_id': group_id, 'file_id': 'encoded-file-id=='})
+    assert result == {'url': 'https://example.test/file?signature=test'}
+    bot.call_action.assert_awaited_once_with('get_group_file_url', group_id='20001', file_id='encoded-file-id==')
+
+
+@pytest.mark.asyncio
+async def test_private_lookup_only_forwards_file_id():
+    bot = AsyncMock()
+    bot.call_action.return_value = {'url': 'http://example.test/file'}
+    assert await get_private_file_url(bot, {'file_id': 'encoded-file-id'}) == {'url': 'http://example.test/file'}
+    bot.call_action.assert_awaited_once_with('get_private_file_url', file_id='encoded-file-id')
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    'params',
+    [
+        {},
+        {'group_id': '20001'},
+        {'file_id': 'file-id'},
+        {'group_id': True, 'file_id': 'file-id'},
+        {'group_id': 0, 'file_id': 'file-id'},
+        {'group_id': -1, 'file_id': 'file-id'},
+        {'group_id': 'other-group', 'file_id': 'file-id'},
+        {'group_id': '２０００１', 'file_id': 'file-id'},
+        {'group_id': '1' * 21, 'file_id': 'file-id'},
+        {'group_id': '20001', 'file_id': ''},
+        {'group_id': '20001', 'file_id': ' padded '},
+        {'group_id': '20001', 'file_id': 123},
+        {'group_id': '20001', 'file_id': 'x' * 4097},
+        {'group_id': '20001', 'file_id': 'line\nbreak'},
+        {'group_id': '20001', 'file_id': 'file-id', 'url': 'https://example.test/untrusted'},
+        {'group_id': '20001', 'file_id': 'file-id', 'action': 'delete_group_file'},
+    ],
+)
+async def test_invalid_group_lookup_is_rejected_before_onebot_call(params):
+    bot = AsyncMock()
+    with pytest.raises(ValueError):
+        await get_group_file_url(bot, params)
+    bot.call_action.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_private_lookup_rejects_extra_scope_or_arbitrary_action():
+    bot = AsyncMock()
+    with pytest.raises(ValueError):
+        await get_private_file_url(bot, {'file_id': 'file-id', 'group_id': '20001'})
+    bot.call_action.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    'url',
+    [
+        None,
+        '',
+        42,
+        'file:///private.txt',
+        'javascript:alert(1)',
+        'https://',
+        'https://name:secret@example.test/file',
+        'https://example.test/file#fragment',
+        'https://example.test:bad/file',
+        'https://example.test/file\nsecret',
+        'https://example.test/' + 'x' * 8192,
+    ],
+)
+async def test_invalid_lookup_result_does_not_expose_payload(url):
+    bot = AsyncMock()
+    bot.call_action.return_value = {'url': url, 'private_metadata': 'private marker'}
+    with pytest.raises(RuntimeError, match='^OneBot did not return a valid file download URL$'):
+        await get_private_file_url(bot, {'file_id': 'file-id'})
+
+
+@pytest.mark.asyncio
+async def test_endpoint_exception_is_sanitized():
+    bot = AsyncMock()
+    bot.call_action.side_effect = RuntimeError('private metadata https://example.test/file?signature=secret')
+    with pytest.raises(RuntimeError, match='^OneBot file URL lookup failed$'):
+        await get_private_file_url(bot, {'file_id': 'file-id'})
