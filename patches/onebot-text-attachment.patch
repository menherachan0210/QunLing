+async def _get_attachment_url(bot: aiocqhttp.CQHttp, action: str, params: dict, *, group: bool) -> dict:
+    """Resolve a captured file identifier without exposing other endpoint data."""
+    expected = {'group_id', 'file_id'} if group else {'file_id'}
+    if not isinstance(params, dict) or set(params) != expected:
+        raise ValueError('Invalid file lookup parameters')
+    file_id = params['file_id']
+    if (
+        not isinstance(file_id, str)
+        or not file_id
+        or file_id != file_id.strip()
+        or len(file_id) > 4096
+        or any(ord(char) < 32 or ord(char) == 127 for char in file_id)
+    ):
+        raise ValueError('Invalid file identifier')
+    payload = {'file_id': file_id}
+    if group:
+        group_id = params['group_id']
+        if isinstance(group_id, bool) or not isinstance(group_id, (int, str)):
+            raise ValueError('Invalid group identifier')
+        group_id = str(group_id)
+        if not group_id.isascii() or not group_id.isdecimal() or len(group_id) > 20 or int(group_id) <= 0:
+            raise ValueError('Invalid group identifier')
+        payload['group_id'] = str(int(group_id))
+    try:
+        result = await _call(bot, action, payload)
+    except Exception:
+        # Endpoint exceptions may contain signed URLs or private file metadata.
+        raise RuntimeError('OneBot file URL lookup failed') from None
+    url = result.get('url') if isinstance(result, dict) else None
+    try:
+        if not isinstance(url, str) or not url or len(url) > 8192 or any(ord(char) <= 32 for char in url):
+            raise ValueError
+        parsed = urlsplit(url)
+        if (
+            parsed.scheme not in {'http', 'https'}
+            or not parsed.hostname
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.fragment
+        ):
+            raise ValueError
+        _ = parsed.port
+    except ValueError:
+        raise RuntimeError('OneBot did not return a valid file download URL') from None
+    return {'url': url}
+
+
+async def get_group_file_url(bot: aiocqhttp.CQHttp, params: dict) -> dict:
+    return await _get_attachment_url(bot, 'get_group_file_url', params, group=True)
+
+
+async def get_private_file_url(bot: aiocqhttp.CQHttp, params: dict) -> dict:
+    return await _get_attachment_url(bot, 'get_private_file_url', params, group=False)
+
+
