+
+
+@pytest.fixture
+def tool_env(monkeypatch):
+    monkeypatch.setattr(text_context, "_CACHE", text_context.AttachmentCache())
+    variables, platform_calls = {}, []
+
+    async def platform_api(*args):
+        platform_calls.append(args)
