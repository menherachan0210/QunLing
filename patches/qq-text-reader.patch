+    )
+
+
+@pytest.mark.parametrize(
+    "chain,status",
+    [
+        ([Quote(origin=MessageChain([]))], "unresolved_quote"),
+        ([Quote(origin=MessageChain([Plain(text="not a file")]))], "unresolved_quote"),
+        ([file("one"), file("two")], "ambiguous"),
