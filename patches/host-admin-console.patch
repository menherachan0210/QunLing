+        async def console_tasks(bot_uuid: str, request_context: RequestContext):
+            import sqlite3
+            from qunling.console_tasks import tasks, parse_filters
+            try:
+                if any(len(quart.request.args.getlist(key)) != 1 for key in quart.request.args):
