+"""Keep the extended image-tool timeout scoped to its exact plugin source."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from langbot_plugin.entities.io.actions.enums import LangBotToRuntimeAction
+
+from langbot.pkg.plugin.handler import RuntimeConnectionHandler
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ('tool_name', 'include_plugins', 'expected_timeout'),
+    [
+        ('generate_image', ['langbot-team/AIImagePlugin'], 420),
+        ('edit_image', ['langbot-team/AIImagePlugin'], 420),
+        ('other_tool', ['langbot-team/AIImagePlugin'], 180),
+        ('generate_image', ['another-author/AIImagePlugin'], 180),
+        ('edit_image', ['langbot-team/OtherPlugin'], 180),
+        ('generate_image', ['langbot-team/AIImagePlugin', 'another-author/OtherPlugin'], 180),
+        ('edit_image', ['langbot-team/AIImagePlugin', 'langbot-team/AIImagePlugin'], 180),
+        ('generate_image', None, 180),
+        ('edit_image', [], 180),
+        ('remember', ['langbot-team/LongTermMemory'], 180),
+    ],
+)
+async def test_tool_timeout_preserves_source_and_request(tool_name, include_plugins, expected_timeout):
+    response = {'result': 'completed'}
+    handler = SimpleNamespace(call_action=AsyncMock(return_value={'tool_response': response}))
+    parameters = {'prompt': 'test prompt'}
+    session = {'session_id': 'test-session'}
+
+    result = await RuntimeConnectionHandler.call_tool(
+        handler,
+        tool_name=tool_name,
+        parameters=parameters,
+        session=session,
+        query_id=123,
+        query_uuid='test-query-uuid',
+        include_plugins=include_plugins,
+    )
+
+    assert result is response
+    handler.call_action.assert_awaited_once_with(
+        LangBotToRuntimeAction.CALL_TOOL,
+        {
+            'tool_name': tool_name,
+            'tool_parameters': parameters,
+            'session': session,
+            'query_id': 123,
+            'query_uuid': 'test-query-uuid',
+            'include_plugins': include_plugins,
+        },
+        timeout=expected_timeout,
+    )
