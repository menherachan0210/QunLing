+class Connection:
+    def __init__(self):
+        self.sent = []
+        self.close = AsyncMock()
+        self.receive = AsyncMock(side_effect=ConnectionClosedError('disconnected'))
+
+    async def send(self, data):
+        request = json.loads(data)
+        self.sent.append(request)
+        if 'action' in request:
+            payload = {'version': 'test-version', 'vars': {}}
+            if request['action'] == PluginToRuntimeAction.INVOKE_LLM.value:
+                payload = {'message': {'role': 'assistant', 'content': 'synthetic-model-result'}}
+            response = ActionResponse.success(payload)
+            response.seq_id = request['seq_id']
+            await self.handler._route_response(response.seq_id, response.model_dump())
+
