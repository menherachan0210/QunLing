+@pytest.mark.asyncio
+async def test_job_has_fresh_authority_and_survives_component_return(worker):
+    handler, plugin, binding, connection = worker
+    gate = asyncio.Event()
+    marker = contextvars.ContextVar('caller-query', default=None)
+    marker_token = marker.set('must-not-follow-job')
+    config = {'nested': {'value': 'original'}}
+    seen = {}
+
+    async def job():
+        await gate.wait()
+        seen['invocation'] = current_invocation(handler)
+        seen['config'] = plugin.get_config()['nested']['value']
+        seen['marker'] = marker.get()
+        return await plugin.get_langbot_version()
+
+    try:
+        with component(worker, config=config) as original:
+            task = plugin.spawn_background(job)
+        config['nested']['value'] = 'changed'
+        assert not original.active
+        gate.set()
+        assert await task == 'test-version'
+        assert seen['invocation'] is not original
+        assert seen['invocation'].api is None
+        assert not seen['invocation'].active
+        assert seen['config'] == 'original'
+        assert seen['marker'] is None
+        assert connection.sent[0]['context'] == binding.model_dump()
+    finally:
+        marker.reset(marker_token)
+        await handler.close()
