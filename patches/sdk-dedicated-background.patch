+@pytest.fixture
+def worker(tmp_path, monkeypatch):
+    monkeypatch.setenv(PLUGIN_FILE_STORAGE_DIR_ENV, str(tmp_path / 'transfers'))
+    connection = Connection()
+    handler = PluginRuntimeHandler(connection, AsyncMock())
+    connection.handler = handler
+    plugin = BasePlugin()
+    plugin.plugin_runtime_handler = handler
+    binding = InstallationBinding(
+        instance_uuid='test-instance',
+        workspace_uuid='test-workspace',
+        installation_uuid='test-installation',
+        placement_generation=1,
+        runtime_revision=1,
+        artifact_digest='a' * 64,
+    )
+    handler.bind_action_context(binding)
+    handler.plugin_container = SimpleNamespace(
+        plugin_instance=plugin,
+        debug=False,
+        enabled=True,
+        status=RuntimeContainerStatus.INITIALIZED,
+        manifest=SimpleNamespace(execution=SimpleNamespace(shared_runtime=None)),
+        plugin_config={},
+    )
+    return handler, plugin, binding, connection
+
+
+@contextmanager
+def component(worker, *, api=None, binding=None, config=None):
+    handler, _, expected, _ = worker
+    binding = expected if binding is None else binding
+    task = asyncio.current_task()
+    handler._action_task_contexts[task] = binding
+    token = handler._current_action_context.set(binding)
+    try:
+        with bind_invocation(handler, api, config=config or {}, binding=binding):
+            yield current_invocation(handler)
+    finally:
+        handler._current_action_context.reset(token)
+        handler._action_task_contexts.pop(task, None)
+
