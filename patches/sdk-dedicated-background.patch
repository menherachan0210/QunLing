+@pytest.mark.asyncio
+async def test_child_cannot_keep_authority_after_job_completes(worker):
+    handler, plugin, _, connection = worker
+    gate = asyncio.Event()
+    children = []
+
+    async def escaped():
+        await gate.wait()
+        await plugin.get_langbot_version()
+
+    async def job():
+        children.append(asyncio.create_task(escaped()))
+
+    try:
+        with component(worker):
+            task = plugin.spawn_background(job)
+        await task
+        gate.set()
+        with pytest.raises(RuntimeError, match='invocation has ended'):
+            await children[0]
+        assert connection.sent == []
+    finally:
+        await handler.close()
