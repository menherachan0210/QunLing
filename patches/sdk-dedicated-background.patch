+            field = {'query-id': 'query_id', 'run-id': 'run_id', 'target-run': 'target_run_id'}[kind]
+            await handler.call_action(PluginToRuntimeAction.INVOKE_LLM, {field: 'old'})
+
+    try:
+        with component(worker):
+            task = plugin.spawn_background(job)
+        with pytest.raises(RuntimeError, match='query or Runner'):
+            await task
+        assert connection.sent == []
+    finally:
+        await handler.close()
+
