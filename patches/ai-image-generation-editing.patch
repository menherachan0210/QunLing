+        "data:image/",
+        "base64",
+        "https://",
+        "offline-private-image",
+    ]
+    descriptor = env.state.variables.get(env.cache.QUERY_CONTEXT_KEY, {})
+    sensitive.extend(
+        descriptor[key] for key in ("owner", "scope", "token") if descriptor.get(key)
