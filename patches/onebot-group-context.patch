+@pytest.mark.asyncio
+async def test_file_resolution_uses_only_scoped_pre_anchor_metadata():
+    bot = AsyncMock()
+    batch = [
+        message('1', segments=[image_file(url=None)]),
+        message('2', group='20002', segments=[image_file(url=None, file_id='other-group')]),
+        message(ANCHOR, NOW),
+        message('3', NOW, segments=[image_file(url=None, file_id='after-question')]),
+    ]
+
+    async def call(action, **parameters):
+        if action == 'get_group_msg_history':
+            return {'messages': batch}
+        assert action == 'get_group_file_url'
