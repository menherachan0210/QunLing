+def _history_integer(value: typing.Any, *, signed: bool = False) -> int:
+    if isinstance(value, bool) or not isinstance(value, (str, int)):
+        raise ValueError('Invalid group context parameters')
+    text = str(value)
+    digits = text[1:] if signed and text.startswith('-') else text
+    if not digits or not digits.isascii() or not digits.isdecimal() or len(digits) > 20:
+        raise ValueError('Invalid group context parameters')
+    result = int(text)
+    if signed:
+        if result == 0 or not -(2**31) <= result < 2**31:
+            raise ValueError('Invalid group context parameters')
+    elif result <= 0:
+        raise ValueError('Invalid group context parameters')
+    return result
+
+
+def _history_image_url(value: typing.Any) -> str | None:
+    if (
+        not isinstance(value, str)
+        or not value
+        or len(value) > 8192
+        or '\\' in value
+        or any(char.isspace() or unicodedata.category(char) in {'Cc', 'Cs'} for char in value)
+    ):
+        return None
+    try:
+        parsed = urlsplit(value)
+        if (
+            parsed.scheme not in {'http', 'https'}
+            or not parsed.hostname
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.fragment
+        ):
+            return None
+        _ = parsed.port
+    except ValueError:
+        return None
+    return value
+
+
+def _history_text(value: typing.Any, limit: int, *, single_line: bool = False) -> str:
+    if not isinstance(value, str):
+        return ''
+    # Bound work before sanitizing; no content is ever interpreted as instructions.
+    return ''.join(
+        char
+        if unicodedata.category(char) not in {'Cc', 'Cf', 'Cs', 'Zl', 'Zp'} or (not single_line and char in '\n\t')
+        else ' '
+        for char in value[:limit]
+    )
+
+
+_HISTORY_IMAGE_SUFFIXES = {'.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp'}
+_HISTORY_IMAGE_MAX_BYTES = 10 * 1024 * 1024
+_HISTORY_FILE_LOOKUP_LIMIT = 8
+_HISTORY_PAGE_SIZE = 100
+_HISTORY_MAX_PAGES = 12
+_HISTORY_SNAPSHOT_MAX_BYTES = 8 * 1024 * 1024
+
+
+def _history_file_image(data: dict) -> tuple[bool, str | None, str | None, str | None]:
+    """Recognize image attachments by filename; actual pixels are checked downstream."""
+    name = data.get('name') or data.get('file')
+    if not isinstance(name, str) or len(name) > 512 or '.' not in name:
+        return False, None, None, None
+    if name.rsplit('.', 1)[-1].lower() not in {ext[1:] for ext in _HISTORY_IMAGE_SUFFIXES}:
+        return False, None, None, None
+    if any(char in name for char in '/\\:') or any(not char.isprintable() for char in name):
+        return True, None, None, 'invalid_metadata'
+    size = data.get('file_size', data.get('size'))
+    if size is not None:
+        if type(size) is str and size.isascii() and size.isdecimal() and len(size) <= 20:
+            size = int(size)
+        if type(size) is not int or size <= 0:
+            return True, None, None, 'invalid_metadata'
+        if size > _HISTORY_IMAGE_MAX_BYTES:
+            return True, None, None, 'too_large'
+    url = _history_image_url(data.get('url'))
+    if url:
+        return True, url, None, None
+    file_id = data.get('file_id') or data.get('id')
+    if (
+        isinstance(file_id, str)
+        and file_id
+        and file_id == file_id.strip()
+        and len(file_id) <= 4096
+        and all(char.isprintable() for char in file_id)
+    ):
+        return True, None, file_id, None
+    return True, None, None, 'missing_url'
+
+
+async def _resolve_history_file_images(bot, result: dict, group_id: int, *, deadline: float) -> None:
+    """Resolve only filtered recent candidates, under the original read deadline."""
+    # Keep partial text/images usable when a file service stalls. The whole
+    # batch, including semaphore waits, shares three seconds with a return margin.
+    deadline = min(deadline - 0.05, time.monotonic() + 3)
+    pending = []
+    for item in reversed(result['messages']):
+        for candidate in reversed(item.pop('_pending_image_files', [])):
+            if len(pending) >= _HISTORY_FILE_LOOKUP_LIMIT:
+                item.setdefault('unavailable_images', []).append(
+                    {'index': candidate['index'], 'reason': 'budget_exceeded'}
+                )
+            else:
+                pending.append((item, candidate))
+    semaphore = asyncio.Semaphore(2)
+
+    async def resolve(item, candidate):
+        try:
+            async with semaphore:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError
+                async with asyncio.timeout(min(3, remaining)):
+                    response = await get_group_file_url(
+                        bot, {'group_id': str(group_id), 'file_id': candidate['file_id']}
+                    )
+                url = _history_image_url(response.get('url'))
+                if not url:
+                    raise ValueError
+            item['images'].append({'index': candidate['index'], 'url': url, 'source': 'image_file'})
+        except Exception:
+            item.setdefault('unavailable_images', []).append({'index': candidate['index'], 'reason': 'lookup_failed'})
+
+    await asyncio.gather(*(resolve(item, candidate) for item, candidate in pending))
+    for item in result['messages']:
+        item['images'].sort(key=lambda image: image['index'])
+
+
+def _history_page_rows(
+    raw: typing.Any, group_id: int, previous_descending: bool | None
+) -> tuple[list, bool | None, int]:
+    messages = raw.get('messages') if isinstance(raw, dict) else None
+    if not isinstance(messages, list) or len(messages) > _HISTORY_PAGE_SIZE:
+        raise RuntimeError('OneBot group context response is invalid')
+    rows = []
+    for position, message in enumerate(messages):
+        if not isinstance(message, dict) or message.get('message_type') != 'group':
+            continue
+        try:
+            if _history_integer(message.get('group_id')) != group_id:
+                continue
+            message_id = _history_integer(message.get('message_id'), signed=True)
+            timestamp = _history_integer(message.get('time'))
+        except ValueError:
+            continue
+        rows.append((position, message_id, timestamp, message))
+    # Normalize each page before prepending it. Globally sorting concatenated
+    # pages would reverse equal-second messages at page boundaries.
+    descending = previous_descending
+    if len(rows) > 1 and rows[0][2] != rows[-1][2]:
+        descending = rows[0][2] > rows[-1][2]
+    rows.sort(key=lambda row: (row[2], -row[0] if descending else row[0]))
+    return rows, descending, len(messages)
+
+
+async def _history_pages(bot, group_id, anchor_id, before_time, window_seconds, max_messages, *, deadline):
+    collected, seen, cursors = [], set(), set()
+    cursor, cursor_time = anchor_id, before_time
+    window_start = before_time - window_seconds
+    scanned, descending, truncated, stop_reason = 0, None, False, 'exhausted'
+    for _ in range(_HISTORY_MAX_PAGES):
+        # Reserve time for normalization and returning useful partial results.
+        remaining = deadline - time.monotonic() - 1
+        if remaining <= 0:
+            if not collected:
+                raise TimeoutError('OneBot group context lookup timed out')
+            truncated, stop_reason = True, 'timeout'
+            break
+        if cursor in cursors:
+            truncated, stop_reason = True, 'no_progress'
+            break
+        cursors.add(cursor)
+        try:
+            async with asyncio.timeout(remaining):
+                raw = await _call(
+                    bot,
+                    'get_group_msg_history',
+                    {
+                        'group_id': str(group_id),
+                        'message_seq': str(cursor),
+                        'count': _HISTORY_PAGE_SIZE,
+                        'reverse_order': True,
+                        'disable_get_url': False,
+                        'parse_mult_msg': False,
+                    },
+                )
+        except Exception as exc:
+            if not collected:
+                raise
+            truncated = True
+            stop_reason = 'timeout' if isinstance(exc, TimeoutError) else 'platform_error'
+            break
+        try:
+            page, descending, count = _history_page_rows(raw, group_id, descending)
+        except Exception:
+            if not collected:
+                raise
+            truncated, stop_reason = True, 'invalid_page'
+            break
+        scanned += count
+        anchor_positions = [index for index, row in enumerate(page) if row[1] == cursor]
+        anchor_position = min(anchor_positions) if anchor_positions else None
+        upper = cursor_time
+        if anchor_position is not None:
+            upper = min(upper, page[anchor_position][2])
+        # reverse_order is forwarded into QQ's native history API; NapCat does
+        # not enforce a documented tie order itself. Do not assume ascending
+        # order for a first page containing only one timestamp.
+        ambiguous = (anchor_position is None or descending is None) and any(row[2] == upper for row in page)
+        truncated |= ambiguous
+        fresh, page_seen = [], set()
+        for index, (_, message_id, timestamp, message) in enumerate(page):
+            if message_id in seen or message_id in page_seen or message_id in {cursor, anchor_id}:
+                continue
+            if not window_start <= timestamp <= upper:
+                continue
+            if timestamp == upper and (anchor_position is None or descending is None or index >= anchor_position):
+                continue
+            page_seen.add(message_id)
+            fresh.append((message_id, timestamp, message))
+        room = max_messages - len(collected)
+        cut = len(fresh) > room
+        retained = fresh[-room:] if room else []
+        collected = retained + collected
+        seen.update(row[0] for row in retained)
+        if cut:
+            truncated, stop_reason = True, 'limit'
+            break
+        if page and page[0][2] < window_start:
+            stop_reason = 'window'
+            break
+        if count < _HISTORY_PAGE_SIZE:
+            stop_reason = ('ambiguous_order' if descending is None else 'anchor_missing') if ambiguous else 'exhausted'
+            break
+        if len(collected) >= max_messages:
+            truncated, stop_reason = True, 'limit'
+            break
+        if not fresh:
+            truncated = True
+            stop_reason = 'ambiguous_order' if ambiguous and descending is None else 'no_progress'
+            break
+        cursor, cursor_time = fresh[0][:2]
+    else:
+        truncated, stop_reason = True, 'page_limit'
+    return collected, scanned, truncated, stop_reason
+
+
+def _group_context_result(
+    rows, window_seconds, max_messages, scanned, truncated, stop_reason, *, deadline: float
+) -> dict:
+    valid_message_ids = {str(row[0]) for row in rows}
+    output = []
+    # Allocate shared budgets while parsing newest content first, rather than
+    # validating every URL and discarding older content afterwards.
+    text_remaining, images_remaining = 1000 * 1000, 256
+    segments_remaining, image_inspections_remaining = 50000, 1024
+    # Leave room for resolving at most eight file URLs and response metadata.
+    snapshot_remaining = _HISTORY_SNAPSHOT_MAX_BYTES - 256 * 1024
+    for message_id, timestamp, message in reversed(rows):
+        if time.monotonic() >= deadline - 0.1:
+            truncated, stop_reason = True, 'timeout'
+            break
+        sender = message.get('sender')
+        sender = sender if isinstance(sender, dict) else {}
+        try:
+            sender_id = str(_history_integer(sender.get('user_id', message.get('user_id'))))
+        except ValueError:
+            sender_id = ''
+        sender_name = _history_text(sender.get('card') or sender.get('nickname'), 80, single_line=True)
+        text, images, reply_id = '', [], None
+        pending_files, unavailable_images = [], []
+        segments = message.get('message')
+        if not isinstance(segments, list):
+            continue
+        segment_limit = min(2000, segments_remaining)
+        text_limit = min(1000, text_remaining)
+        item_truncated = len(segments) > segment_limit
+        for index, segment in enumerate(segments[:segment_limit]):
+            if time.monotonic() >= deadline - 0.1:
+                truncated, stop_reason = True, 'timeout'
+                item_truncated = True
+                break
+            segments_remaining -= 1
+            if not isinstance(segment, dict) or not isinstance(segment.get('data'), dict):
+                continue
+            data = segment['data']
+            kind = segment.get('type')
+            if kind == 'text':
+                content = data.get('text')
+                if isinstance(content, str):
+                    item_truncated |= len(text) + len(content) > text_limit
+                    if len(text) < text_limit:
+                        text += _history_text(content, text_limit - len(text))
+            elif kind == 'at':
+                placeholder = '[提及用户]'
+                item_truncated |= len(text) + len(placeholder) > text_limit
+                text += placeholder[: max(0, text_limit - len(text))]
+            elif kind == 'image':
+                if images_remaining <= 0 or image_inspections_remaining <= 0:
+                    item_truncated = True
+                    continue
+                image_inspections_remaining -= 1
+                url = _history_image_url(data.get('url')) or _history_image_url(data.get('file'))
+                if url is not None:
+                    images.append({'index': index, 'url': url})
+                    images_remaining -= 1
+                else:
+                    unavailable_images.append({'index': index, 'reason': 'missing_url'})
+            elif kind == 'file':
+                if images_remaining <= 0 or image_inspections_remaining <= 0:
+                    item_truncated = True
+                    continue
+                image_inspections_remaining -= 1
+                is_image, url, file_id, reason = _history_file_image(data)
+                if not is_image:
+                    continue
+                if reason:
+                    unavailable_images.append({'index': index, 'reason': reason})
+                elif url:
+                    images.append({'index': index, 'url': url, 'source': 'image_file'})
+                    images_remaining -= 1
+                elif file_id:
+                    pending_files.append({'index': index, 'file_id': file_id})
+                    images_remaining -= 1
+            elif kind == 'reply':
+                try:
+                    candidate = str(_history_integer(data.get('id'), signed=True))
+                except ValueError:
+                    continue
+                if candidate in valid_message_ids and candidate != str(message_id):
+                    reply_id = candidate
+        text_remaining -= len(text)
+        item = {
+            'message_id': str(message_id),
+            'time': timestamp,
+            'sender_name': sender_name,
+            'sender_id': sender_id,
+            'text': text,
+            'images': images,
+        }
+        if item_truncated:
+            item['truncated'] = True
+            truncated = True
+        if reply_id is not None:
+            item['reply_message_id'] = reply_id
+        if pending_files:
+            item['_pending_image_files'] = pending_files
+        if unavailable_images:
+            item['unavailable_images'] = unavailable_images
+        item_size = len(json.dumps(item, ensure_ascii=False).encode()) + 2
+        if item_size > snapshot_remaining:
+            truncated, stop_reason = True, 'snapshot_limit'
+            break
+        snapshot_remaining -= item_size
+        output.append(item)
+
+    output.reverse()
+    available_ids = {item['message_id'] for item in output}
+    for item in output:
+        if item.get('reply_message_id') not in available_ids:
+            item.pop('reply_message_id', None)
+    return {
+        'messages': output,
+        'scanned_messages': scanned,
+        'window_seconds': window_seconds,
+        'max_messages': max_messages,
+        'truncated': truncated,
+        'stop_reason': stop_reason,
+    }
+
+
+def _bound_history_snapshot(result: dict) -> None:
+    """Bound the final UTF-8 JSON snapshot, including resolved file URLs."""
+    messages = result['messages']
+    sizes = [len(json.dumps(item, ensure_ascii=False).encode()) for item in messages]
+    metadata_size = len(json.dumps({**result, 'messages': []}, ensure_ascii=False).encode())
+    total = metadata_size + sum(sizes) + max(0, len(messages) - 1) * 2
+    if total <= _HISTORY_SNAPSHOT_MAX_BYTES:
+        return
+    result['truncated'], result['stop_reason'] = True, 'snapshot_limit'
+    metadata_size = len(json.dumps({**result, 'messages': []}, ensure_ascii=False).encode())
+    total = metadata_size + sum(sizes) + max(0, len(messages) - 1) * 2
+    removed = 0
+    while total > _HISTORY_SNAPSHOT_MAX_BYTES and removed < len(messages):
+        total -= sizes[removed] + (2 if len(messages) - removed > 1 else 0)
+        removed += 1
+    del messages[:removed]
+    retained_ids = {item['message_id'] for item in messages}
+    for item in messages:
+        if item.get('reply_message_id') not in retained_ids:
+            item.pop('reply_message_id', None)
+
+
+async def get_group_recent_context(bot: aiocqhttp.CQHttp, params: dict) -> dict:
+    """Return bounded direct content around a caller's trusted group message."""
+    required = {'group_id', 'before_message_id', 'before_time'}
+    if (
+        not isinstance(params, dict)
+        or not required <= set(params)
+        or set(params) - required - {'window_seconds', 'max_messages'}
+    ):
+        raise ValueError('Invalid group context parameters')
+    group_id = _history_integer(params['group_id'])
+    anchor_id = _history_integer(params['before_message_id'], signed=True)
+    before_time = _history_integer(params['before_time'])
+    window_seconds = params.get('window_seconds', 86400)
+    max_messages = params.get('max_messages', 1000)
+    if type(window_seconds) is not int or not 3600 <= window_seconds <= 604800:
+        raise ValueError('Invalid group context window')
+    if type(max_messages) is not int or not 100 <= max_messages <= 1000:
+        raise ValueError('Invalid group context message limit')
+    now = int(time.time())
+    if before_time < 1577836800 or not now - 900 <= before_time <= now + 60:
+        raise ValueError('Invalid group context time boundary')
+    try:
+        deadline = time.monotonic() + 12
+        async with asyncio.timeout(12):
+            rows, scanned, truncated, stop_reason = await _history_pages(
+                bot, group_id, anchor_id, before_time, window_seconds, max_messages, deadline=deadline
+            )
+            result = _group_context_result(
+                rows, window_seconds, max_messages, scanned, truncated, stop_reason, deadline=deadline
+            )
+            await _resolve_history_file_images(bot, result, group_id, deadline=deadline)
+            _bound_history_snapshot(result)
+            return result
+    except Exception:
+        raise RuntimeError('OneBot group context lookup failed') from None
+
+
+PLATFORM_API_MAP['get_group_recent_context'] = get_group_recent_context
