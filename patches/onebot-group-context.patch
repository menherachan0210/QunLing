+        ({'file': 'C:\\private.png'}, 'invalid_metadata'),
+        ({'url': None, 'file_id': None}, 'missing_url'),
+    ],
+)
+async def test_bad_image_file_is_reported_without_lookup_or_old_image_fallback(changes, reason):
+    result, bot = await lookup([message('1', segments=[image_file(**changes)])])
+    row = result['messages'][0]
