+@pytest.mark.asyncio
+async def test_timeout_is_twelve_seconds_and_cancels_the_call(monkeypatch):
+    original_timeout = asyncio.timeout
+    deadlines = []
+
+    def immediate_timeout(seconds):
+        deadlines.append(seconds)
+        return original_timeout(0)
+
+    monkeypatch.setattr(api.asyncio, 'timeout', immediate_timeout)
+    bot = AsyncMock()
+
+    async def blocked(*args, **kwargs):
+        await asyncio.Event().wait()
+
+    bot.call_action.side_effect = blocked
+    with pytest.raises(RuntimeError, match='^OneBot group context lookup failed$'):
+        await api.get_group_recent_context(bot, params())
+    assert deadlines == [12]
+
