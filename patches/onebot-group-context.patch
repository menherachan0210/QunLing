+def _history_integer(value: typing.Any, *, signed: bool = False) -> int:
+    if isinstance(value, bool) or not isinstance(value, (str, int)):
+        raise ValueError('Invalid group context parameters')
+    text = str(value)
+    digits = text[1:] if signed and text.startswith('-') else text
+    if not digits or not digits.isascii() or not digits.isdecimal() or len(digits) > 20:
+        raise ValueError('Invalid group context parameters')
+    result = int(text)
+    if signed:
+        if result == 0 or not -(2**31) <= result < 2**31:
+            raise ValueError('Invalid group context parameters')
+    elif result <= 0:
+        raise ValueError('Invalid group context parameters')
+    return result
+
+
+def _history_image_url(value: typing.Any) -> str | None:
+    if (
+        not isinstance(value, str)
+        or not value
+        or len(value) > 8192
+        or '\\' in value
+        or any(char.isspace() or unicodedata.category(char) in {'Cc', 'Cs'} for char in value)
+    ):
+        return None
+    try:
+        parsed = urlsplit(value)
+        if (
+            parsed.scheme not in {'http', 'https'}
+            or not parsed.hostname
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.fragment
+        ):
+            return None
+        _ = parsed.port
+    except ValueError:
+        return None
+    return value
+
+
+def _history_text(value: typing.Any, limit: int, *, single_line: bool = False) -> str:
+    if not isinstance(value, str):
+        return ''
+    # Bound work before sanitizing; no content is ever interpreted as instructions.
+    return ''.join(
+        char
+        if unicodedata.category(char) not in {'Cc', 'Cf', 'Cs', 'Zl', 'Zp'} or (not single_line and char in '\n\t')
+        else ' '
+        for char in value[:limit]
+    )
+
+
+_HISTORY_IMAGE_SUFFIXES = {'.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp'}
+_HISTORY_IMAGE_MAX_BYTES = 10 * 1024 * 1024
+_HISTORY_FILE_LOOKUP_LIMIT = 8
+
+
+def _history_file_image(data: dict) -> tuple[bool, str | None, str | None, str | None]:
+    """Recognize image attachments by filename; actual pixels are checked downstream."""
+    name = data.get('name') or data.get('file')
+    if not isinstance(name, str) or len(name) > 512 or '.' not in name:
+        return False, None, None, None
+    if name.rsplit('.', 1)[-1].lower() not in {ext[1:] for ext in _HISTORY_IMAGE_SUFFIXES}:
+        return False, None, None, None
+    if any(char in name for char in '/\\:') or any(not char.isprintable() for char in name):
+        return True, None, None, 'invalid_metadata'
+    size = data.get('file_size', data.get('size'))
+    if size is not None:
+        if type(size) is str and size.isascii() and size.isdecimal() and len(size) <= 20:
+            size = int(size)
+        if type(size) is not int or size <= 0:
+            return True, None, None, 'invalid_metadata'
+        if size > _HISTORY_IMAGE_MAX_BYTES:
+            return True, None, None, 'too_large'
+    url = _history_image_url(data.get('url'))
+    if url:
+        return True, url, None, None
+    file_id = data.get('file_id') or data.get('id')
+    if (
+        isinstance(file_id, str)
+        and file_id
+        and file_id == file_id.strip()
+        and len(file_id) <= 4096
+        and all(char.isprintable() for char in file_id)
+    ):
+        return True, None, file_id, None
+    return True, None, None, 'missing_url'
+
+
+async def _resolve_history_file_images(bot, result: dict, group_id: int, *, deadline: float) -> None:
+    """Resolve only filtered recent candidates, under the original read deadline."""
+    # Keep partial text/images usable when a file service stalls. The whole
+    # batch, including semaphore waits, shares three seconds with a return margin.
+    deadline = min(deadline - 0.05, time.monotonic() + 3)
+    pending = []
+    for item in reversed(result['messages']):
+        for candidate in reversed(item.pop('_pending_image_files', [])):
+            if len(pending) >= _HISTORY_FILE_LOOKUP_LIMIT:
+                item.setdefault('unavailable_images', []).append(
+                    {'index': candidate['index'], 'reason': 'budget_exceeded'}
+                )
+            else:
+                pending.append((item, candidate))
+    semaphore = asyncio.Semaphore(2)
+
+    async def resolve(item, candidate):
+        try:
+            async with semaphore:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError
+                async with asyncio.timeout(min(3, remaining)):
+                    response = await get_group_file_url(
+                        bot, {'group_id': str(group_id), 'file_id': candidate['file_id']}
+                    )
+                url = _history_image_url(response.get('url'))
+                if not url:
+                    raise ValueError
+            item['images'].append({'index': candidate['index'], 'url': url, 'source': 'image_file'})
+        except Exception:
+            item.setdefault('unavailable_images', []).append({'index': candidate['index'], 'reason': 'lookup_failed'})
+
+    await asyncio.gather(*(resolve(item, candidate) for item, candidate in pending))
+    for item in result['messages']:
+        item['images'].sort(key=lambda image: image['index'])
+
+
+def _group_context_result(raw: typing.Any, group_id: int, anchor_id: int, before_time: int, *, deadline: float) -> dict:
+    def check_deadline() -> None:
+        # asyncio timeouts cannot interrupt synchronous parsing of native data.
+        if time.monotonic() >= deadline:
+            raise TimeoutError('OneBot group context lookup timed out')
+
+    check_deadline()
+    window_start = before_time - 3600
+    messages = raw.get('messages') if isinstance(raw, dict) else None
+    if not isinstance(messages, list) or len(messages) > 100:
+        raise RuntimeError('OneBot group context response is invalid')
+    rows = []
+    for position, message in enumerate(messages):
+        check_deadline()
+        if not isinstance(message, dict) or message.get('message_type') != 'group':
+            continue
+        try:
+            if _history_integer(message.get('group_id')) != group_id:
+                continue
+            message_id = _history_integer(message.get('message_id'), signed=True)
+            timestamp = _history_integer(message.get('time'))
+        except ValueError:
+            continue
+        rows.append((position, message_id, timestamp, message))
+
+    # NapCat keeps native ordering. Infer descending batches from distinct times;
+    # equal timestamps retain native order, which is the only available tie-break.
+    descending = len(rows) > 1 and rows[0][2] > rows[-1][2]
+    anchors = [row for row in rows if row[1] == anchor_id]
+    anchor_position = None
+    if anchors:
+        anchor = max(anchors) if descending else min(anchors)
+        anchor_position = anchor[0]
+        before_time = min(before_time, anchor[2])
+    eligible, seen = [], set()
+    for position, message_id, timestamp, message in rows:
+        if message_id == anchor_id or message_id in seen:
+            continue
+        if not window_start <= timestamp <= before_time:
+            continue
+        if timestamp == before_time:
+            # Without the anchor, second-resolution timestamps cannot distinguish
+            # a preceding message from a later message in that same second.
+            if anchor_position is None:
+                continue
+            if (not descending and position >= anchor_position) or (descending and position <= anchor_position):
+                continue
+        seen.add(message_id)
+        eligible.append((timestamp, position, message_id, message))
+    eligible.sort(key=lambda row: (row[0], -row[1] if descending else row[1]))
+    valid_message_ids = {str(row[2]) for row in eligible}
+    output = []
+    truncated = False
+    # Allocate shared budgets while parsing newest content first, rather than
+    # validating every URL and discarding older content afterwards.
+    text_remaining, images_remaining = 16000, 100
+    segments_remaining, image_inspections_remaining = 5000, 200
+    for timestamp, _, message_id, message in reversed(eligible):
+        check_deadline()
+        sender = message.get('sender')
+        sender = sender if isinstance(sender, dict) else {}
+        try:
+            sender_id = str(_history_integer(sender.get('user_id', message.get('user_id'))))
+        except ValueError:
+            sender_id = ''
+        sender_name = _history_text(sender.get('card') or sender.get('nickname'), 80, single_line=True)
+        text, images, reply_id = '', [], None
+        pending_files, unavailable_images = [], []
+        segments = message.get('message')
+        if not isinstance(segments, list):
+            continue
+        segment_limit = min(2000, segments_remaining)
+        text_limit = min(1000, text_remaining)
+        truncated |= len(segments) > segment_limit
+        for index, segment in enumerate(segments[:segment_limit]):
+            check_deadline()
+            segments_remaining -= 1
+            if not isinstance(segment, dict) or not isinstance(segment.get('data'), dict):
+                continue
+            data = segment['data']
+            kind = segment.get('type')
+            if kind == 'text':
+                content = data.get('text')
+                if isinstance(content, str):
+                    truncated |= len(text) + len(content) > text_limit
+                    if len(text) < text_limit:
+                        text += _history_text(content, text_limit - len(text))
+            elif kind == 'at':
+                placeholder = '[提及用户]'
+                truncated |= len(text) + len(placeholder) > text_limit
+                text += placeholder[: max(0, text_limit - len(text))]
+            elif kind == 'image':
+                if images_remaining <= 0 or image_inspections_remaining <= 0:
+                    truncated = True
+                    continue
+                image_inspections_remaining -= 1
+                url = _history_image_url(data.get('url')) or _history_image_url(data.get('file'))
+                if url is not None:
+                    images.append({'index': index, 'url': url})
+                    images_remaining -= 1
+                else:
+                    unavailable_images.append({'index': index, 'reason': 'missing_url'})
+            elif kind == 'file':
+                if images_remaining <= 0 or image_inspections_remaining <= 0:
+                    truncated = True
+                    continue
+                image_inspections_remaining -= 1
+                is_image, url, file_id, reason = _history_file_image(data)
+                if not is_image:
+                    continue
+                if reason:
+                    unavailable_images.append({'index': index, 'reason': reason})
+                elif url:
+                    images.append({'index': index, 'url': url, 'source': 'image_file'})
+                    images_remaining -= 1
+                elif file_id:
+                    pending_files.append({'index': index, 'file_id': file_id})
+                    images_remaining -= 1
+            elif kind == 'reply':
+                try:
+                    candidate = str(_history_integer(data.get('id'), signed=True))
+                except ValueError:
+                    continue
+                if candidate in valid_message_ids and candidate != str(message_id):
+                    reply_id = candidate
+        text_remaining -= len(text)
+        item = {
+            'message_id': str(message_id),
+            'time': timestamp,
+            'sender_name': sender_name,
+            'sender_id': sender_id,
+            'text': text,
+            'images': images,
+        }
+        if reply_id is not None:
+            item['reply_message_id'] = reply_id
+        if pending_files:
+            item['_pending_image_files'] = pending_files
+        if unavailable_images:
+            item['unavailable_images'] = unavailable_images
+        output.append(item)
+
+    check_deadline()
+    output.reverse()
+    return {'messages': output, 'scanned_messages': len(messages), 'window_seconds': 3600, 'truncated': truncated}
+
+
+async def get_group_recent_context(bot: aiocqhttp.CQHttp, params: dict) -> dict:
+    """Return bounded direct content around a caller's trusted group message."""
+    if not isinstance(params, dict) or set(params) != {'group_id', 'before_message_id', 'before_time'}:
+        raise ValueError('Invalid group context parameters')
+    group_id = _history_integer(params['group_id'])
+    anchor_id = _history_integer(params['before_message_id'], signed=True)
+    before_time = _history_integer(params['before_time'])
+    now = int(time.time())
+    if before_time < 1577836800 or not now - 900 <= before_time <= now + 60:
+        raise ValueError('Invalid group context time boundary')
+    try:
+        deadline = time.monotonic() + 12
+        async with asyncio.timeout(12):
+            raw = await _call(
+                bot,
+                'get_group_msg_history',
+                {
+                    'group_id': str(group_id),
+                    'message_seq': str(anchor_id),
+                    'count': 100,
+                    # NapCat uses this flag to walk backwards from the anchor;
+                    # False walks forwards and can include later group messages.
+                    'reverse_order': True,
+                    'disable_get_url': False,
+                    'parse_mult_msg': False,
+                },
+            )
+            result = _group_context_result(raw, group_id, anchor_id, before_time, deadline=deadline)
+            await _resolve_history_file_images(bot, result, group_id, deadline=deadline)
+            return result
+    except Exception:
+        raise RuntimeError('OneBot group context lookup failed') from None
+
+
+PLATFORM_API_MAP['get_group_recent_context'] = get_group_recent_context
