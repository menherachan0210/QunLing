+"""Scoped recent-context bridge tests using synthetic OneBot payloads only."""
+
+import asyncio
+from unittest.mock import AsyncMock
+
+import pytest
+
+from langbot.pkg.platform.adapters.aiocqhttp import platform_api as api
+
+
+NOW = 1800000000
+GROUP = '20001'
+ANCHOR = '-500'
+
+
+@pytest.fixture(autouse=True)
+def freeze_clock(monkeypatch):
+    monkeypatch.setattr(api.time, 'time', lambda: NOW)
+
+
+def params(**changes):
+    return {'group_id': GROUP, 'before_message_id': ANCHOR, 'before_time': NOW, **changes}
+
+
+def message(message_id, timestamp=NOW - 1, *, group=GROUP, segments=None, **changes):
+    return {
+        'message_id': message_id,
+        'time': timestamp,
+        'message_type': 'group',
+        'group_id': group,
+        'sender': {'user_id': '30001', 'nickname': 'Synthetic member'},
+        'message': segments if segments is not None else [text('Synthetic discussion')],
+        **changes,
+    }
+
+
+def text(value):
+    return {'type': 'text', 'data': {'text': value}}
+
+
+def image(value='https://example.test/image.png?signature=test'):
+    return {'type': 'image', 'data': {'url': value, 'file': 'unused-file', 'summary': 'not returned'}}
+
+
+def image_file(**changes):
+    return {
+        'type': 'file',
+        'data': {
+            'file': 'synthetic.PNG',
+            'file_id': 'captured-file-id',
+            'file_size': '4096',
+            'url': 'https://example.test/download?signed=yes',
+            **changes,
+        },
+    }
+
+
+@pytest.mark.asyncio
+async def test_group_file_image_and_http_image_file_fallback_preserve_order():
+    result, bot = await lookup(
+        [
+            message(
+                '1',
+                segments=[
+                    image_file(),
+                    {'type': 'image', 'data': {'file': 'https://example.test/ordinary.png'}},
+                ],
+            )
+        ]
+    )
+    assert result['messages'][0]['images'] == [
+        {'index': 0, 'url': 'https://example.test/download?signed=yes', 'source': 'image_file'},
+        {'index': 1, 'url': 'https://example.test/ordinary.png'},
+    ]
+    assert bot.call_action.await_count == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('name', ['notes.txt', 'pages.zip', 'pages.rar', 'pages.7z', 'image.png.exe'])
+async def test_non_image_files_never_trigger_download_url_lookup(name):
+    result, bot = await lookup([message('1', segments=[image_file(file=name, url=None)])])
+    assert result['messages'][0]['images'] == []
+    assert 'unavailable_images' not in result['messages'][0]
+    assert bot.call_action.await_count == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    'changes,reason',
