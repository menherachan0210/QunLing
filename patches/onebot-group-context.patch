+        return {'url': 'https://example.test/resolved.png'}
+
+    bot.call_action.side_effect = call
+    result = await api.get_group_recent_context(bot, params())
+    assert [row['message_id'] for row in result['messages']] == ['1']
+    assert result['messages'][0]['images'][0]['url'] == 'https://example.test/resolved.png'
+    assert '_pending_image_files' not in repr(result)
+    assert 'captured-file-id' not in repr(result)
+    assert bot.call_action.await_count == 2
+
