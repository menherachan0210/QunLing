+def history_bot(records, *, descending=False):
+    """Emulate NapCat's include-cursor pages with synthetic messages only."""
+    positions = {str(row['message_id']): index for index, row in enumerate(records)}
+    bot = AsyncMock()
+
+    async def call(action, **parameters):
+        if action == 'get_group_file_url':
+            assert parameters['group_id'] == GROUP
+            return {'url': 'https://example.test/resolved.png'}
+        assert action == 'get_group_msg_history'
+        assert parameters['group_id'] == GROUP
+        assert parameters['count'] == 100
+        assert parameters['reverse_order'] is True
+        position = positions[parameters['message_seq']]
+        page = records[max(0, position - parameters['count'] + 1) : position + 1]
+        return {'messages': list(reversed(page)) if descending else list(page)}
+
+    bot.call_action.side_effect = call
+    return bot
+
