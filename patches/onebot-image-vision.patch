+@pytest.mark.asyncio
+@pytest.mark.parametrize('download_succeeds', [True, False])
+@pytest.mark.parametrize('quoted', [True, False])
+async def test_onebot_image_reaches_local_agent_or_becomes_placeholder(
+    mock_app, sample_query, monkeypatch, download_succeeds, quoted
+):
+    from importlib import import_module
+
+    from langbot.pkg.agent.runner.query_entry_adapter import QueryEntryAdapter
+    from langbot.pkg.platform.adapters.aiocqhttp.message_converter import AiocqhttpMessageConverter
+
+    model = Mock()
+    model.model_entity.uuid = 'vision-model'
+    model.model_entity.abilities = ['vision']
+    mock_app.model_mgr.get_model_by_uuid = AsyncMock(return_value=model)
+    _attach_runner_descriptor(mock_app)
+    mock_app.sess_mgr.get_session = AsyncMock(
+        return_value=provider_session.Session(
+            launcher_type=sample_query.launcher_type,
+            launcher_id=sample_query.launcher_id,
+            sender_id=sample_query.sender_id,
+            bot_uuid=sample_query.bot_uuid,
+        )
+    )
+    mock_app.sess_mgr.get_conversation = AsyncMock(return_value=_conversation())
+    mock_app.plugin_connector.emit_event = AsyncMock(return_value=_prompt_preprocessing_context())
+    download = AsyncMock(return_value=('aW1hZ2U=', 'png'))
+    if not download_succeeds:
+        download.side_effect = TimeoutError()
+    monkeypatch.setattr(
+        'langbot.pkg.platform.adapters.aiocqhttp.message_converter.image.qq_image_url_to_base64', download
+    )
+    converted = await AiocqhttpMessageConverter.target2yiri(
+        [{'type': 'image', 'data': {'url': 'https://example.test/image.png'}}]
+    )
+    sample_query.pipeline_config = _pipeline_config({'primary': 'vision-model', 'fallbacks': []})
+    sample_query.pipeline_config['trigger']['misc']['combine-quote-message'] = quoted
+    image_component = converted[1]
+    if quoted:
+        image_component = platform_message.Quote(
+            id='quoted-image', origin=platform_message.MessageChain([image_component])
+        )
+    sample_query.message_chain = platform_message.MessageChain(
+        [platform_message.Plain(text='describe this'), image_component]
+    )
+    sample_query.messages = []
+    sample_query.variables = {}
+
+    import_module('langbot.pkg.pipeline.pipelinemgr')
+    preproc_module = import_module('langbot.pkg.pipeline.preproc.preproc')
+    result = await preproc_module.PreProcessor(mock_app).process(sample_query, 'PreProcessor')
+    runner_input = QueryEntryAdapter._build_input(result.new_query)
+    content = runner_input.contents
+
+    assert content[0].type == 'text'
+    if download_succeeds:
+        assert content[1].type == 'image_base64'
+        assert content[1].image_base64 == 'data:image/png;base64,aW1hZ2U='
+    else:
+        assert [item.type for item in content] == ['text', 'text']
+        assert content[1].text == '[Image]'
