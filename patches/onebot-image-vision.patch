diff --git a/tests/unit_tests/platform/test_onebot_incoming_images.py b/tests/unit_tests/platform/test_onebot_incoming_images.py
new file mode 100644
index 0000000..9dc6fcb
--- /dev/null
+++ b/tests/unit_tests/platform/test_onebot_incoming_images.py
@@ -0,0 +1,76 @@
+from __future__ import annotations
+
+import asyncio
+from unittest.mock import AsyncMock
+
+import pytest
+
+from langbot.pkg.platform.adapters.aiocqhttp.message_converter import AiocqhttpMessageConverter
+from langbot.pkg.utils import httpclient
+from langbot_plugin.api.entities.builtin.platform import message as platform_message
+
+
+@pytest.mark.asyncio
+async def test_onebot_downloads_image_bytes_for_vision(monkeypatch):
+    download = AsyncMock(return_value=('aW1hZ2U=', 'jpeg'))
+    monkeypatch.setattr(
+        'langbot.pkg.platform.adapters.aiocqhttp.message_converter.image.qq_image_url_to_base64', download
+    )
+    image_url = 'https://example.test/download?token=test-token'
+
+    chain = await AiocqhttpMessageConverter.target2yiri(
+        [{'type': 'image', 'data': {'file': 'picture.jpg', 'url': image_url}}]
+    )
+
+    download.assert_awaited_once_with(image_url)
+    assert isinstance(chain[1], platform_message.Image)
+    assert chain[1].base64 == 'data:image/jpeg;base64,aW1hZ2U='
+    assert chain[1].url == image_url
+    assert chain[1].image_id == 'picture.jpg'
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    'download_error',
+    [asyncio.TimeoutError(), httpclient.RemoteResponseTooLargeError('too large')],
+)
+async def test_onebot_image_failure_retains_message_without_leaking_url(monkeypatch, caplog, download_error):
+    download = AsyncMock(side_effect=download_error)
+    monkeypatch.setattr(
+        'langbot.pkg.platform.adapters.aiocqhttp.message_converter.image.qq_image_url_to_base64', download
+    )
+    image_url = 'https://example.test/download?rkey=private-test-key'
+
+    chain = await AiocqhttpMessageConverter.target2yiri(
+        [
+            {'type': 'image', 'data': {'url': image_url}},
+            {'type': 'text', 'data': {'text': 'describe this'}},
+        ]
+    )
+
+    assert chain[1].url == image_url
+    assert not chain[1].base64
+    assert chain[2].text == 'describe this'
+    assert 'OneBot image download failed' in caplog.text
+    assert 'private-test-key' not in caplog.text
+    assert image_url not in caplog.text
+
+
+@pytest.mark.asyncio
+async def test_onebot_does_not_fetch_emoji_package_or_local_file_reference(monkeypatch):
+    download = AsyncMock()
+    monkeypatch.setattr(
+        'langbot.pkg.platform.adapters.aiocqhttp.message_converter.image.qq_image_url_to_base64', download
+    )
+
+    chain = await AiocqhttpMessageConverter.target2yiri(
+        [
+            {'type': 'image', 'data': {'emoji_package_id': '14', 'summary': 'smile'}},
+            {'type': 'image', 'data': {'file': 'local-reference.image'}},
+        ]
+    )
+
+    download.assert_not_awaited()
+    assert isinstance(chain[1], platform_message.Face)
+    assert isinstance(chain[2], platform_message.Image)
+    assert not chain[2].base64
