[Unit]
Description=Renew the QunLing HTTPS certificate
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ExecStart=/opt/qunling-certbot/bin/certbot renew --config-dir /etc/qunling-tls --work-dir /var/lib/qunling-tls --logs-dir /var/log/qunling-tls --quiet --no-random-sleep-on-renew
